{
  "name": "vorg-eavy-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build:library": "node build-edge-library.mjs",
    "build:algorithm": "tsc -p tsconfig.json",
    "build:suppliers": "tsc -p tsconfig.supplier-vetting.json",
    "build:negotiation": "tsc -p tsconfig.conscious-negotiation.json",
    "vet:suppliers": "npm run build:suppliers && node run-supplier-vetting.mjs",
    "build:forecast": "tsc -p tsconfig.forecast.json",
    "build:positioning": "tsc -p tsconfig.market-positioning.json",
    "train:public-priors": "node run-public-prior-training.mjs --download",
    "test:library": "npm run build:library && node tests/edge-commerce-library.test.mjs",
    "test:algorithm": "npm run build:algorithm && node tests/drop-os-algorithm.test.mjs",
    "test:suppliers": "npm run build:suppliers && node tests/supplier-vetting-agent.test.mjs",
    "test:negotiation": "npm run build:negotiation && node tests/conscious-supplier-negotiator.test.mjs",
    "test:forecast": "npm run build:forecast && node tests/sales-forecast.test.mjs",
    "test:positioning": "npm run build:positioning && node tests/market-positioning-prediction.test.mjs",
    "test:growth-path": "node ../finance/tests/six-figure-sales-simulation.test.mjs",
    "test:public-priors": "node tests/public-commerce-priors.test.mjs",
    "test:ads-practice": "node tests/ads-public-priors-practice.test.mjs",
    "test:unit": "npm run test:library && npm run test:algorithm && npm run test:suppliers && npm run test:negotiation && npm run test:public-priors && npm run test:ads-practice && npm run test:forecast && npm run test:positioning && npm run test:growth-path",
    "test:flow": "node test-drop-os-flow.mjs",
    "build:strategy": "tsc -p tsconfig.strategy-generator.json",
    "test:strategy": "npm run build:strategy && node tests/strategy-generator.test.mjs",
    "generate:strategy": "npm run build:strategy && node run-strategy-generator.mjs"
  },
  "devDependencies": {
    "playwright": "^1.60.0",
    "typescript": "^5.6.3"
  }
}
